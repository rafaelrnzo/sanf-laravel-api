{
    "name": "laravel/lumen",
    "description": "The Laravel Lumen Framework.",
    "keywords": ["framework", "laravel", "lumen"],
    "license": "MIT",
    "type": "project",
    "version": "6.1.0",
    "require": {
        "php": "^7.4",
        "ext-json": "*",
        "doctrine/dbal": "^2.10",
        "fideloper/proxy": "^4.4",
        "firebase/php-jwt": "^5.2",
        "godruoyi/php-snowflake": "^1.0",
        "guzzlehttp/guzzle": "^6.5",
        "hidehalo/nanoid-php": "^1.1",
        "illuminate/mail": "^6.18",
        "illuminate/notifications": "^6.18",
        "illuminate/redis": "^6.0",
        "jenssegers/agent": "^2.6",
        "laravel/helpers": "^1.1",
        "laravel/lumen-framework": "^6.0",
        "league/flysystem-aws-s3-v3": "1.0.28",
        "myclabs/php-enum": "^1.7",
        "pragmarx/health": "^1.0",
        "predis/predis": "^1.1",
        "ramsey/uuid": "^4.1",
        "spatie/data-transfer-object": "^2.8",
        "spatie/laravel-fractal": "^5.8",
        "yajra/laravel-datatables-oracle": "~9.0"
    },
    "require-dev": {
        "fzaninotto/faker": "^1.4",
        "phpunit/phpunit": "^8.0",
        "mockery/mockery": "^1.0"
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/factories",
            "packages/sanf/core/database/seeds"
        ],
        "psr-4": {
            "App\\": "app/",
            "NbsPhp\\Core\\": "packages/nbs-php/lumen-core/src",
            "Sanf\\Core\\": "packages/sanf/core/src",
            "Sanf\\Console\\": "packages/sanf/console/src",
            "Sanf\\Api\\": "packages/sanf/api/src",
            "Sanf\\Web\\": "packages/sanf/web/src"
        },
        "files": [
            "packages/nbs-php/lumen-core/src/helpers.php"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
