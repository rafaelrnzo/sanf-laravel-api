# Docker Environment Settings

########################################
# PHP Environment
########################################

# Xdebug 3 (PHP 8.3)
# Keep MODE=off by default — Xdebug adds noticeable overhead.
# Enable on demand, e.g. PHP_XDEBUG_MODE=debug or debug,profile
PHP_XDEBUG_MODE=off
PHP_XDEBUG_CLIENT_HOST=host.docker.internal
PHP_XDEBUG_CLIENT_PORT=9003
PHP_XDEBUG_DISCOVER_CLIENT_HOST=0
PHP_XDEBUG_START_WITH_REQUEST=yes
PHP_XDEBUG_IDEKEY=DOCKER_XDEBUG
PHP_XDEBUG_OUTPUT_DIR=/var/www/app/xdebug

# Opcache
PHP_OPCACHE_VALIDATE_TIMESTAMPS=1
PHP_OPCACHE_MAX_ACCELERATED_FILES=6000
PHP_OPCACHE_MEMORY_CONSUMPTION=128

# Backing Services
PGSQL_SODIUM_PORT=
PGSQL_SODIUM_USERNAME=
PGSQL_SODIUM_PASSWORD=

########################################
# Application
########################################

