APP_NAME=Lumen
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

SENTRY_LARAVEL_DSN=

AUTH_EMAIL_VERIFY_URL="${APP_URL}/pages/verify-email"
AUTH_ACTIVATION_URL="${ADMIN_URL}/pages/activation"
AUTH_RESET_PASS_URL="${ADMIN_URL}/pages/reset-password"

# OAUTH LOGIN
JWT_GOOGLE_AUDIENCE=
JWT_APPLE_AUDIENCE=

LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_SLACK_WEBHOOK_URL=

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=secret

CACHE_DRIVER=file
QUEUE_CONNECTION=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_DRIVER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-reply@email.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TO_ADMIN=test@mail.com,test@mail.com,test@mail.com

FILESYSTEM_DRIVER=minio
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
MINIO_BUCKET=
MINIO_ENDPOINT=

JWT_SECRET=${APP_KEY}
JWT_TTL=20160
JWT_REFRESH_TTL=43800
JWT_ISSUER=${APP_NAME}

APP_CLIENT_ID=
APP_CLIENT_SECRET=

HORIZON_BASIC_AUTH_USERNAME=
HORIZON_BASIC_AUTH_PASSWORD=

SANF_INTERNAL_URL=
SANF_INTERNAL_CLIENT_ID=

FIREBASE_SA_FILE=

CORE_H2H_CLIENT_ID=
CORE_H2H_CLIENT_SECRET=
